# ---------------------------------------------------------------------------
# LensFlow - environment configuration
# Copy to `.env` at the repository root:  cp .env.example .env
# NEVER commit a real .env file. Never put any of these values in client code.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# If this is unreachable and NODE_ENV !== 'production', the server transparently
# falls back to an ephemeral in-process MongoDB so `npm run dev` always works.
MONGO_URI=mongodb://localhost:27017/lensflow
# Set to `true` to disable the memory-server fallback entirely (fail fast).
DB_STRICT=false

# --- Auth ------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- Uploads / storage -----------------------------------------------------
UPLOAD_DIR=./uploads
# local | s3  (s3 requires STORAGE_* vars below; see README)
STORAGE_DRIVER=local
MAX_UPLOAD_MB=25
MAX_FILES_PER_REQUEST=60
GALLERY_WIDTH=1600
THUMB_WIDTH=400
IMAGE_FORMAT=webp

# S3 / Cloudinary / GCS (future drivers - unused while STORAGE_DRIVER=local)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# --- Email (Nodemailer) ----------------------------------------------------
# Leave EMAIL_HOST empty in development: emails are written to server/uploads/mail/*.eml
# so you can read them without a real mailbox.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LensFlow <no-reply@lensflow.test>"

# --- Payments -------------------------------------------------------------
# mock | esewa | khalti
# With no gateway credentials configured the server automatically uses the MOCK
# provider, which exercises the exact same create/verify/refund code paths.
PAYMENT_PROVIDER=mock
CURRENCY=NPR
# Seconds a checkout session stays valid
PAYMENT_SESSION_TTL=1800

# eSewa ePay (merchant portal: merchant.esewa.com.np)
ESEWA_MERCHANT_ID=
ESEWA_SECRET=
ESEWA_PRODUCT_CODE=EPAYTEST

# Khalti ePayment (merchant portal: test-admin.khalti.com)
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=

# --- App behaviour ---------------------------------------------------------
ALLOW_CLIENT_DOWNLOADS=true
ALLOW_ORIGINAL_DOWNLOADS=false
CRON_ENABLED=true
NOTIFICATION_RETENTION_DAYS=180
MAX_PAGE_SIZE=100

# --- Seed (development only) ----------------------------------------------
SEED_PHOTOS_PER_PROJECT=48
SEED_RANDOM_SEED=1337
